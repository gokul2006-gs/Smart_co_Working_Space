MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lnrcurj.mongodb.net/aperture?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
APP_URL=http://localhost:8080

# --- Admin seed (npm run seed:admin) ---
ADMIN_EMAIL=admin@aperture.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Aperture Admin

# --- Demo users seed (npm run seed) ---
SEED_DEFAULT_PASSWORD=Password123!

# --- Email (SMTP) — logs to console if not set ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your mail@gmail.com
SMTP_PASS=app password or smtp password
EMAIL_FROM=noreply@aperture.local
APP_URL=http://localhost:8080

# --- Payment gateway: stripe | razorpay | (unset = manual payment) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd

# Razorpay (set PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_CURRENCY=INR
RAZORPAY_USD_INR_RATE=83
